<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.taxonomy</groupId>
        <artifactId>taxonomy</artifactId>
        <version>1.3.1-SNAPSHOT</version>
    </parent>

    <artifactId>taxonomy-build</artifactId>
    <packaging>pom</packaging>
    <name>Taxonomy Build Policy</name>
    <description>Authoritative quality gates and browser verification executed after the complete reactor</description>

    <dependencies>
        <dependency>
            <groupId>com.taxonomy</groupId>
            <artifactId>taxonomy-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.taxonomy</groupId>
            <artifactId>taxonomy-coverage</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>${maven.multiModuleProjectDirectory}/.github</workingDirectory>
                    <installDirectory>${project.build.directory}/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-pinned-node</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>install-node-and-npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <nodeVersion>${node.version}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-pinned-browser-test-dependencies</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <arguments>ci --ignore-scripts --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-pinned-playwright-browsers</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <arguments>${taxonomy.playwright.install.arguments}</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-canonical-api-transport-contract</id>
                        <phase>integration-test</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <arguments>run test:api-transport</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-maven-owned-browser-verification</id>
                        <phase>integration-test</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <arguments>run verify:ui</arguments>
                            <environmentVariables>
                                <TAXONOMY_UI_SUITE>${taxonomy.ui.suite}</TAXONOMY_UI_SUITE>
                                <TAXONOMY_UI_PROFILE_FILTER>${taxonomy.ui.profile.filter}</TAXONOMY_UI_PROFILE_FILTER>
                                <TAXONOMY_UI_OUTPUT_ROOT>${maven.multiModuleProjectDirectory}/target/ui-verification</TAXONOMY_UI_OUTPUT_ROOT>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>test-coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments><argument>.github/scripts/test-check-coverage.py</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-documentation-link-checker</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments><argument>.github/scripts/test-check-doc-links.py</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enforce-reactor-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments>
                                <argument>.github/scripts/check-coverage.py</argument>
                                <argument>--xml</argument><argument>taxonomy-coverage/target/site/jacoco-aggregate/jacoco.xml</argument>
                                <argument>--policy</argument><argument>.github/coverage-policy.json</argument>
                                <argument>--report</argument><argument>target/coverage-gate.txt</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enforce-packaged-dependency-hygiene-report</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments>
                                <argument>.github/scripts/check-dependency-hygiene.py</argument>
                                <argument>--sbom</argument><argument>target/taxonomy-sbom.json</argument>
                                <argument>--expected-pdfbox-version</argument><argument>${pdfbox.version}</argument>
                                <argument>--report</argument><argument>target/dependency-hygiene-report.txt</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-sbom-companion</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments>
                                <argument>.github/scripts/generate-vex.py</argument>
                                <argument>--sbom</argument><argument>target/taxonomy-sbom.json</argument>
                                <argument>--output</argument><argument>target/taxonomy-vex.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-documentation-links</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments><argument>.github/scripts/check-doc-links.py</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-frontend-api-boundaries</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments><argument>.github/scripts/check-frontend-api-boundaries.py</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-hibernate-search-alignment</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments>
                                <argument>.github/scripts/check-hibernate-search-alignment.py</argument>
                                <argument>--tree</argument><argument>target/hibernate-search-dependencies.txt</argument>
                                <argument>--search-version</argument><argument>${hibernate-search.version}</argument>
                                <argument>--lucene-version</argument><argument>${lucene.version}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-supply-chain-pins</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments>
                                <argument>.github/scripts/check-supply-chain-pins.py</argument>
                                <argument>--report</argument><argument>target/supply-chain-pins.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-workflow-test-authority</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments><argument>.github/scripts/check-workflow-test-authority.py</argument></arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
