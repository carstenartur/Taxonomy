{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Taxonomy chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "existing",
            "local",
            "keycloak"
          ]
        },
        "keycloakClientSecretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "existing",
            "postgres",
            "mssql"
          ],
          "default": "existing"
        },
        "url": {
          "type": "string",
          "pattern": "^$|^jdbc:(postgresql|sqlserver)://[^\\s@]+$"
        },
        "username": {
          "type": "string",
          "pattern": "^[^\\r\\n]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "postgres"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^$|^jdbc:postgresql://[^\\s@]+$"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "mssql"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^$|^jdbc:sqlserver://[^\\s@]+$"
              }
            }
          }
        }
      ]
    },
    "existingSecret": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "$comment": "Credential-value suffixes, case-insensitive and separator-tolerant. Metadata such as TOKEN_URI or API_KEY_FILE remains valid. Keep aligned with LocalSetup and the template guard.",
        "not": {
          "pattern": "([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Pp][Ww][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Aa][Pp][Ii][._-]*[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][._-]*[Kk][Ee][Yy]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?)$"
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "secretEnv": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "key",
          "optional"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "upgrade": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "Recreate",
            "RollingUpdate"
          ]
        },
        "allowConcurrentApplicationVersions": {
          "type": "boolean"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
