<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.taxonomy</groupId>
        <artifactId>taxonomy</artifactId>
        <version>1.3.2-SNAPSHOT</version>
    </parent>

    <artifactId>taxonomy-build</artifactId>
    <packaging>jar</packaging>
    <name>Taxonomy Build Policy</name>
    <description>Authoritative quality gates and browser verification executed after the complete reactor</description>

    <dependencies>
        <dependency>
            <groupId>com.taxonomy</groupId>
            <artifactId>taxonomy-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.taxonomy</groupId>
            <artifactId>taxonomy-coverage</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <skipITs>${taxonomy.quality.skip}</skipITs>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <hibernate.search.version>${hibernate-search.version}</hibernate.search.version>
                                <hibernate.orm.version.prefix>7.4.</hibernate.orm.version.prefix>
                                <lucene.version>${lucene.version}</lucene.version>
                                <pdfbox.version>${pdfbox.version}</pdfbox.version>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>${maven.multiModuleProjectDirectory}/.github</workingDirectory>
                    <installDirectory>${project.build.directory}/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-pinned-node</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>install-node-and-npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <nodeVersion>${node.version}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-pinned-browser-test-dependencies</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <arguments>ci --ignore-scripts --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-pinned-playwright-browsers</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <arguments>${taxonomy.playwright.install.arguments}</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-canonical-api-transport-contract</id>
                        <phase>integration-test</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <arguments>run test:api-transport</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-maven-owned-browser-verification</id>
                        <phase>integration-test</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <arguments>run verify:ui</arguments>
                            <environmentVariables>
                                <TAXONOMY_UI_SUITE>${taxonomy.ui.suite}</TAXONOMY_UI_SUITE>
                                <TAXONOMY_UI_PROFILE_FILTER>${taxonomy.ui.profile.filter}</TAXONOMY_UI_PROFILE_FILTER>
                                <TAXONOMY_UI_OUTPUT_ROOT>${maven.multiModuleProjectDirectory}/target/ui-verification</TAXONOMY_UI_OUTPUT_ROOT>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>generate-sbom-companion</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments>
                                <argument>.github/scripts/generate-vex.py</argument>
                                <argument>--sbom</argument><argument>target/taxonomy-sbom.json</argument>
                                <argument>--output</argument><argument>target/taxonomy-vex.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-frontend-api-boundaries</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python3</executable>
                            <arguments><argument>.github/scripts/check-frontend-api-boundaries.py</argument></arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>supply-chain-policy</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/SupplyChainPinPolicyRepositoryTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
