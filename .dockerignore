# Version-control history is not a Docker build input.
.git

# Local IDE and operating-system metadata.
.idea
.vscode
*.iml
.DS_Store
Thumbs.db

# Maven, Node, browser and generated verification output.
target
**/target
node_modules
**/node_modules
.github/playwright-report
.github/test-results
playwright-report
test-results

# Large root-level model caches and runtime state.
/models
/data

# Local deployment overrides and secrets must never enter the build context.
.env
.env.*
docker-compose*.override.yml
