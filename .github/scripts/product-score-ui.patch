+        if (!Number.isFinite(Number(parentScore))) {
+            parentScore = detail ? detail.parentScore : null;
+        }
+        if (!Number.isFinite(Number(parentScore))) return 0;
+        return clampScore(clampScore(parentScore) * clampScore(rawScore) / 100);
