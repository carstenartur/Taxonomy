<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>com.taxonomy</groupId>
    <artifactId>taxonomy</artifactId>
    <version>1.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Taxonomy Architecture Analyzer</name>
    <description>Spring Boot web application that loads a C3-taxonomy catalogue and provides full-text search, KNN vector search, architecture-overlay DSL editing, and LLM-assisted analysis.</description>
    <url>https://github.com/carstenartur/Taxonomy</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Carsten Hammer</name>
        <url>https://github.com/carstenartur</url>
    </organization>

    <developers>
        <developer>
            <id>carstenartur</id>
            <name>Carsten Hammer</name>
            <url>https://github.com/carstenartur</url>
            <roles><role>Lead Developer</role></roles>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/carstenartur/Taxonomy.git</connection>
        <developerConnection>scm:git:git@github.com:carstenartur/Taxonomy.git</developerConnection>
        <url>https://github.com/carstenartur/Taxonomy</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/carstenartur/Taxonomy/issues</url>
    </issueManagement>

    <modules>
        <!-- Dependency-free release and repository tooling is built first. -->
        <module>taxonomy-tooling</module>
        <module>taxonomy-domain</module>
        <module>taxonomy-dsl</module>
        <module>taxonomy-export</module>
        <module>taxonomy-extension-api</module>
        <module>taxonomy-app</module>
        <!-- Coverage consumes classes and execution data produced by all shipped modules above. -->
        <module>taxonomy-coverage</module>
        <!-- Must stay last: build-policy and browser verification consume the complete reactor. -->
        <module>taxonomy-build</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <djl.version>0.36.0</djl.version>
        <skipITs>true</skipITs>
        <excludedGroups>real-llm,onnx,db-postgres,db-mssql,db-oracle</excludedGroups>
        <poi.version>5.5.1</poi.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <lucene.version>9.12.3</lucene.version>
        <!-- Hibernate Search 8.4 targets Hibernate ORM 7.4 and Lucene 9.12.3.
             The platform BOM coordinates mapper, backend, ORM and Lucene. -->
        <hibernate-search.version>8.4.0.Final</hibernate-search.version>
        <hibernate-search-backend.version>${hibernate-search.version}</hibernate-search-backend.version>
        <jgit.version>7.7.1.202607240634-r</jgit.version>
        <jgit-storage-hibernate.version>0.10.0</jgit-storage-hibernate.version>
        <d3-hierarchy.version>3.1.2</d3-hierarchy.version>
        <springdoc.version>3.1.0</springdoc.version>
        <postgresql.version>42.7.12</postgresql.version>
        <jackson-2-bom.version>2.22.1</jackson-2-bom.version>
        <jackson-bom.version>3.1.5</jackson-bom.version>
        <selenium.version>4.46.0</selenium.version>
        <selenium.container.image>selenium/standalone-chrome:4.46.0-20260707</selenium.container.image>
        <archunit.version>1.5.0</archunit.version>
        <flexmark.version>0.64.8</flexmark.version>
        <xstream.version>1.4.21</xstream.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <cyclonedx.version>2.9.3</cyclonedx.version>
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <maven-fluido-skin.version>2.1.0</maven-fluido-skin.version>
        <maven-surefire-report.version>3.5.6</maven-surefire-report.version>
        <maven-project-info-reports.version>3.9.0</maven-project-info-reports.version>
        <git-commit-id.version>9.1.0</git-commit-id.version>
        <jacoco.version>0.8.15</jacoco.version>
        <maven-enforcer.version>3.6.3</maven-enforcer.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <node.version>v24.18.0</node.version>
        <releaseCheckCurrentState>development</releaseCheckCurrentState>
        <releaseCheckRequireClean>true</releaseCheckRequireClean>
        <taxonomy.model.revision>5c38ec7c405ec4b44b94cc5a9bb96e735b38267a</taxonomy.model.revision>
        <taxonomy.model.download.skip>true</taxonomy.model.download.skip>
        <taxonomy.ui.skip>true</taxonomy.ui.skip>
        <taxonomy.quality.skip>true</taxonomy.quality.skip>
        <taxonomy.ui.suite>all</taxonomy.ui.suite>
        <taxonomy.ui.profile.filter></taxonomy.ui.profile.filter>
        <taxonomy.playwright.install.arguments>exec -- playwright install --with-deps chromium firefox webkit</taxonomy.playwright.install.arguments>
    </properties>

    <repositories>
        <repository>
            <id>jgit-storage-hibernate-releases</id>
            <name>jgit-storage-hibernate anonymous releases</name>
            <url>https://raw.githubusercontent.com/carstenartur/jgit-storage-hibernate/maven-repository/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Keep the fixed Jackson 2 family ahead of the Hibernate Search
                 platform, which otherwise manages the vulnerable 2.21.3 line. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-2-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- The aggregate D3 WebJar references 3.0.1, whose generated Maven
                 metadata is incomplete. Manage the compatible 3.1.2 release so
                 clean builds resolve complete dependency metadata without a
                 warning while retaining D3's supported 3.x range. -->
            <dependency>
                <groupId>org.webjars.npm</groupId>
                <artifactId>d3-hierarchy</artifactId>
                <version>${d3-hierarchy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.hibernate.search</groupId>
                <artifactId>hibernate-search-platform-bom</artifactId>
                <version>${hibernate-search.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration><skip>true</skip></configuration>
            </plugin>
            <!-- Inherited by every code module. This is the critical difference
                 from the former taxonomy-app-only instrumentation. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer.version}</version>
                <executions>
                    <execution>
                        <id>enforce-packaged-dependency-hygiene</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.16,3.9.17)</version>
                                    <message>Use the checked-in Maven Wrapper (./mvnw or mvnw.cmd).</message>
                                </requireMavenVersion>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.apache.pdfbox:*:(,3.0.0):jar:compile</exclude>
                                        <exclude>org.apache.pdfbox:*:(,3.0.0):jar:runtime</exclude>
                                        <exclude>org.apache.pdfbox:xmpbox:*:jar:compile</exclude>
                                        <exclude>org.apache.pdfbox:xmpbox:*:jar:runtime</exclude>
                                        <exclude>com.vladsch.flexmark:flexmark-pdf-converter:*:jar:compile</exclude>
                                        <exclude>com.vladsch.flexmark:flexmark-pdf-converter:*:jar:runtime</exclude>
                                        <exclude>com.openhtmltopdf:*pdfbox*:*:jar:compile</exclude>
                                        <exclude>com.openhtmltopdf:*pdfbox*:*:jar:runtime</exclude>
                                    </excludes>
                                    <message>Packaged dependency hygiene failed. See docs/dev/DEPENDENCY_HYGIENE.md before adding an exception.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx.version}</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>generate-aggregate-sbom</id>
                        <phase>package</phase>
                        <goals><goal>makeAggregateBom</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>application</projectType>
                    <outputDirectory>${maven.multiModuleProjectDirectory}/target</outputDirectory>
                    <outputFormat>all</outputFormat>
                    <outputName>taxonomy-sbom</outputName>
                    <outputReactorProjects>false</outputReactorProjects>
                    <skipNotDeployed>false</skipNotDeployed>
                    <schemaVersion>1.6</schemaVersion>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeProvidedScope>true</includeProvidedScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeSystemScope>false</includeSystemScope>
                    <includeTestScope>false</includeTestScope>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>download-pinned-embedding-model</id>
                        <phase>initialize</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.model.download.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>bash</executable>
                            <environmentVariables>
                                <MODEL_REVISION>${taxonomy.model.revision}</MODEL_REVISION>
                            </environmentVariables>
                            <arguments>
                                <argument>.github/scripts/download-embedding-model.sh</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>${maven-site-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.skins</groupId>
                        <artifactId>maven-fluido-skin</artifactId>
                        <version>${maven-fluido-skin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>${maven-surefire-report.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.skins</groupId>
                        <artifactId>maven-fluido-skin</artifactId>
                        <version>${maven-fluido-skin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>${maven-project-info-reports.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.skins</groupId>
                        <artifactId>maven-fluido-skin</artifactId>
                        <version>${maven-fluido-skin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>ci</id>
            <properties>
                <skipITs>false</skipITs>
                <excludedGroups>real-llm,db-mssql,db-oracle</excludedGroups>
                <taxonomy.model.download.skip>false</taxonomy.model.download.skip>
                <taxonomy.ui.skip>false</taxonomy.ui.skip>
                <taxonomy.quality.skip>false</taxonomy.quality.skip>
                <taxonomy.ui.suite>all</taxonomy.ui.suite>
            </properties>
        </profile>
        <profile>
            <id>release-check</id>
            <properties>
                <!-- The dependency-free Java tooling performs the release-plan check. -->
                <taxonomy.release.check>true</taxonomy.release.check>
            </properties>
        </profile>
        <profile>
            <id>quality</id>
            <properties><taxonomy.quality.skip>false</taxonomy.quality.skip></properties>
        </profile>
        <profile>
            <id>ui-tests</id>
            <properties>
                <taxonomy.ui.skip>false</taxonomy.ui.skip>
                <taxonomy.ui.suite>all</taxonomy.ui.suite>
            </properties>
        </profile>
        <profile>
            <id>core-integration</id>
            <properties>
                <skipITs>false</skipITs>
                <it.test>DiagnosticsContainerIT,DiagnosticsWithApiKeyContainerIT,CoreUiAcceptanceIT,ProductionPersistenceRestartIT</it.test>
                <excludedGroups>real-llm,db-postgres,db-mssql,db-oracle</excludedGroups>
                <taxonomy.model.download.skip>false</taxonomy.model.download.skip>
            </properties>
        </profile>
        <profile>
            <id>database-postgres</id>
            <properties>
                <skipITs>false</skipITs><it.test>*Postgres*IT</it.test>
                <excludedGroups>real-llm,onnx</excludedGroups>
                <taxonomy.model.download.skip>true</taxonomy.model.download.skip>
            </properties>
        </profile>
        <profile>
            <id>database-mssql</id>
            <properties>
                <skipITs>false</skipITs><it.test>*Mssql*IT</it.test>
                <excludedGroups>real-llm,onnx</excludedGroups>
                <taxonomy.model.download.skip>true</taxonomy.model.download.skip>
            </properties>
        </profile>
        <profile>
            <id>database-oracle</id>
            <properties>
                <skipITs>false</skipITs><it.test>*Oracle*IT</it.test>
                <excludedGroups>real-llm,onnx</excludedGroups>
                <taxonomy.model.download.skip>true</taxonomy.model.download.skip>
            </properties>
        </profile>
        <profile>
            <id>onnx</id>
            <properties>
                <skipITs>false</skipITs>
                <it.test>LocalOnnxPipelineIT,OnnxSeleniumIT</it.test>
                <runOnnxTests>true</runOnnxTests>
                <excludedGroups>real-llm,db-postgres,db-mssql,db-oracle</excludedGroups>
                <taxonomy.model.download.skip>false</taxonomy.model.download.skip>
            </properties>
        </profile>
        <profile>
            <id>architecture-tests</id>
            <properties><test>ArchitectureTest,ArchitectureCycleBoundaryTest,ArchitectureExceptionLedgerTest,ArchitectureCycleRuleRegressionTest</test></properties>
        </profile>
        <profile>
            <id>document-import-tests</id>
            <properties><test>DocumentImportControllerTest,DocumentParserServiceTest,DocumentImportLimitsTest</test></properties>
        </profile>
        <profile>
            <id>archimate-import-tests</id>
            <properties><test>ArchiMateWorkspaceImportTests,CatalogFacadeTest</test></properties>
        </profile>
        <profile>
            <id>screenshots</id>
            <properties>
                <skipITs>false</skipITs><it.test>ScreenshotGeneratorIT</it.test>
                <generateScreenshots>true</generateScreenshots>
                <excludedGroups>real-llm,db-postgres,db-mssql,db-oracle</excludedGroups>
                <taxonomy.model.download.skip>false</taxonomy.model.download.skip>
            </properties>
        </profile>
    </profiles>

</project>
