<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.taxonomy</groupId>
        <artifactId>taxonomy</artifactId>
        <version>1.5.3-SNAPSHOT</version>
    </parent>

    <artifactId>taxonomy-build</artifactId>
    <packaging>jar</packaging>
    <name>Taxonomy Build Policy</name>
    <description>Authoritative quality gates and browser verification executed after the complete reactor</description>

    <properties>
        <documentTemplateE2E>false</documentTemplateE2E>
        <documentTemplateRenderPreview>false</documentTemplateRenderPreview>
        <!-- Repository-wide policy tests inspect current reactor outputs and shared files. -->
        <maven.build.cache.enabled>false</maven.build.cache.enabled>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.taxonomy</groupId>
            <artifactId>taxonomy-extension-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.taxonomy</groupId>
            <artifactId>taxonomy-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.taxonomy</groupId>
            <artifactId>taxonomy-coverage</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>com.taxonomy</groupId>
            <artifactId>taxonomy-tooling</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jacoco</groupId>
            <artifactId>org.jacoco.core</artifactId>
            <version>${jacoco.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Each required guard owns a fail-on-empty execution. A successful sibling
                 must not hide an empty/missing selected guard, even in focused runs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/ArchitectureModuleGraphTest.java</exclude>
                                <exclude>**/ArchitectureModuleExtractionTest.java</exclude>
                                <exclude>**/PluginModuleBoundaryTest.java</exclude>
                                <exclude>**/ArchitectureSelectorSynchronizationTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>required-ArchitectureModuleGraphTest</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <test>ArchitectureModuleGraphTest</test>
                            <failIfNoTests>true</failIfNoTests>
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                        </configuration>
                    </execution>
                    <execution>
                        <id>required-ArchitectureModuleExtractionTest</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <test>ArchitectureModuleExtractionTest</test>
                            <failIfNoTests>true</failIfNoTests>
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                        </configuration>
                    </execution>
                    <execution>
                        <id>required-PluginModuleBoundaryTest</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <test>PluginModuleBoundaryTest</test>
                            <failIfNoTests>true</failIfNoTests>
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                        </configuration>
                    </execution>
                    <execution>
                        <id>required-ArchitectureSelectorSynchronizationTest</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <test>ArchitectureSelectorSynchronizationTest</test>
                            <failIfNoTests>true</failIfNoTests>
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excludedGroups}</excludedGroups>
                    <systemPropertyVariables>
                        <taxonomy.project.version>${project.version}</taxonomy.project.version>
                        <taxonomy.maven.executable>${maven.home}/bin/mvn</taxonomy.maven.executable>
                        <taxonomy.maven.user-settings>${taxonomy.maven.user-settings}</taxonomy.maven.user-settings>
                        <taxonomy.app.shard.coverage.enabled>${taxonomy.app.shard.coverage.enabled}</taxonomy.app.shard.coverage.enabled>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <skipITs>${taxonomy.quality.skip}</skipITs>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <excludes>
                                <exclude>${taxonomy.coverage.policy.exclude}</exclude>
                            </excludes>
                            <systemPropertyVariables>
                                <hibernate.search.version>${hibernate-search.version}</hibernate.search.version>
                                <hibernate.orm.version.prefix>7.4.</hibernate.orm.version.prefix>
                                <lucene.version>${lucene.version}</lucene.version>
                                <pdfbox.version>${pdfbox.version}</pdfbox.version>
                                <documentTemplateE2E>${documentTemplateE2E}</documentTemplateE2E>
                                <documentTemplateRenderPreview>${documentTemplateRenderPreview}</documentTemplateRenderPreview>
                                <taxonomy.ui.skip>${taxonomy.ui.skip}</taxonomy.ui.skip>
                                <taxonomy.ui.suite>${taxonomy.ui.suite}</taxonomy.ui.suite>
                                <taxonomy.ui.profile.filter>${taxonomy.ui.profile.filter}</taxonomy.ui.profile.filter>
                                <taxonomy.interoperability.skip>${taxonomy.interoperability.skip}</taxonomy.interoperability.skip>
                                <taxonomy.production.image.skip>${taxonomy.production.image.skip}</taxonomy.production.image.skip>
                                <taxonomy.node.executable>${taxonomy.node.executable}</taxonomy.node.executable>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>${maven.multiModuleProjectDirectory}/.github</workingDirectory>
                    <installDirectory>${taxonomy.frontend.directory}</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-pinned-browser-test-dependencies</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <arguments>ci --ignore-scripts --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-pinned-playwright-browsers</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <skip>${taxonomy.ui.skip}</skip>
                            <arguments>${taxonomy.playwright.install.arguments}</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>stage-reactor-interoperability-application</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.interoperability.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>bash</executable>
                            <arguments><argument>.github/scripts/stage-ui-application.sh</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>validate-original-reactor-junit-outcomes</id><phase>verify</phase><goals><goal>exec</goal></goals>
                        <configuration><skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory><executable>${java.home}/bin/java</executable>
                            <arguments><argument>-cp</argument><argument>${maven.multiModuleProjectDirectory}/taxonomy-tooling/target/classes</argument>
                                <argument>com.taxonomy.tooling.TaxonomyTooling</argument><argument>check-junit-outcomes</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-sbom-companion</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${taxonomy.quality.skip}</skip>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${maven.multiModuleProjectDirectory}/taxonomy-tooling/target/taxonomy-tooling-${project.version}.jar</argument>
                                <argument>generate-sbom-companion</argument>
                                <argument>--sbom</argument><argument>target/taxonomy-sbom.json</argument>
                                <argument>--output</argument><argument>target/taxonomy-vex.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>ci-database-compatibility</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <!-- Build guards belong to every companion, including required-* executions. -->
                <configuration><skipTests>false</skipTests></configuration>
            </plugin></plugins></build>
        </profile>
        <profile><id>ci</id><properties><documentTemplateE2E>true</documentTemplateE2E><documentTemplateRenderPreview>true</documentTemplateRenderPreview></properties></profile>
        <profile>
            <id>ui-tests</id>
            <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
                <executions><execution><id>required-ui-scenarios</id>
                    <goals><goal>integration-test</goal><goal>verify</goal></goals>
                    <configuration><skipITs>false</skipITs><skipTests>false</skipTests>
                        <includes><include>**/UiScenarioIT.java</include></includes>
                        <failIfNoTests>true</failIfNoTests><failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                        <systemPropertyVariables><taxonomy.ui.skip>false</taxonomy.ui.skip></systemPropertyVariables>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>ci-app-test-shards-core</id>
            <properties>
                <!-- The existing document E2E workflow owns this sliced CI execution. -->
                <documentTemplateE2E>false</documentTemplateE2E>
                <documentTemplateRenderPreview>false</documentTemplateRenderPreview>
                <maven.build.cache.enabled>false</maven.build.cache.enabled>
            </properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
                <executions><execution><configuration>
                    <!-- The plugin companion owns these original reports in split CI. -->
                    <excludes>
                        <exclude>${taxonomy.coverage.policy.exclude}</exclude>
                        <exclude>**/ExternalPluginPackagedIT.java</exclude>
                        <exclude>**/OptionalFeaturePackagedIT.java</exclude>
                    </excludes>
                </configuration></execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>ci-plugin-packaging</id>
            <properties>
                <maven.build.cache.enabled>false</maven.build.cache.enabled>
            </properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <!-- Build guards belong to every companion, including required-* executions. -->
                <configuration><skipTests>false</skipTests></configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>ci-app-test-shards-coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <executions><execution>
                            <id>verify-complete-app-test-shard-inventory</id>
                            <phase>validate</phase>
                            <goals><goal>exec</goal></goals>
                            <configuration>
                                <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                <executable>${java.home}/bin/java</executable>
                                <arguments>
                                    <argument>-cp</argument>
                                    <argument>${maven.multiModuleProjectDirectory}/taxonomy-tooling/target/classes</argument>
                                    <argument>com.taxonomy.tooling.TaxonomyTooling</argument>
                                    <argument>check-app-test-shards</argument>
                                    <argument>--verify</argument>
                                    <argument>true</argument>
                                </arguments>
                            </configuration>
                        </execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>coverage-policy-only</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <skipITs>false</skipITs>
                                    <includes>
                                        <include>**/ReactorCoveragePolicyIT.java</include>
                                    </includes>
                                    <failIfNoTests>true</failIfNoTests>
                                    <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>plugin-packaging-tests</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <!-- The actual suite owner always fails closed on missing tests. -->
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>document-template-report-e2e</id>
            <properties>
                <skipITs>false</skipITs>
                <taxonomy.quality.skip>false</taxonomy.quality.skip>
                <taxonomy.ui.skip>true</taxonomy.ui.skip>
                <it.test>DocumentTemplateReportDownloadIT</it.test>
                <documentTemplateE2E>true</documentTemplateE2E>
            </properties>
        </profile>
        <profile>
            <id>github-actions-playwright-runtime</id>
            <activation>
                <property>
                    <name>env.GITHUB_ACTIONS</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <!-- GitHub's runner contains the Chromium and Firefox runtime,
                     but the verified WebKit launch proves that its GTK/GStreamer
                     libraries are incomplete. Install only WebKit's required OS
                     packages, then fetch all browser binaries from the pinned
                     package-lock dependency instead of reinstalling every browser's
                     OS dependency set. -->
                <taxonomy.playwright.install.arguments>run install:playwright:github</taxonomy.playwright.install.arguments>
            </properties>
        </profile>
        <profile>
            <id>supply-chain-policy</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/SupplyChainPinPolicyRepositoryTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
