<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Independent operator-installed artifact; the host is not a compile or runtime dependency. -->
    <groupId>com.taxonomy</groupId>
    <artifactId>taxonomy-leanix-plugin</artifactId>
    <version>1.5.1-SNAPSHOT</version>
    <name>Taxonomy LeanIX Read Plugin</name>
    <licenses><license><name>MIT License</name><url>https://opensource.org/licenses/MIT</url></license></licenses>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <taxonomy.sdk.version>${project.version}</taxonomy.sdk.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.taxonomy</groupId><artifactId>taxonomy-extension-api</artifactId>
            <version>${taxonomy.sdk.version}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.22.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId><artifactId>httpclient5</artifactId><version>5.6.4</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.20</version><scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope>
        </dependency>
    </dependencies>
    <build><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.1</version>
            <configuration><archive><manifestEntries>
                <Plugin-Id>taxonomy.leanix</Plugin-Id>
                <Plugin-Version>${project.version}</Plugin-Version>
                <Plugin-Requires>&gt;=1.1.0 &amp; &lt;2.0.0</Plugin-Requires>
                <Taxonomy-Plugin-Mode>STARTUP</Taxonomy-Plugin-Mode>
                <Taxonomy-Plugin-Capabilities>inventory.read</Taxonomy-Plugin-Capabilities>
            </manifestEntries></archive></configuration>
        </plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
            <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <shadedArtifactAttached>false</shadedArtifactAttached>
                    <relocations>
                        <relocation><pattern>com.fasterxml.jackson</pattern><shadedPattern>com.taxonomy.plugins.leanix.internal.jackson</shadedPattern></relocation>
                        <relocation><pattern>org.apache.hc</pattern><shadedPattern>com.taxonomy.plugins.leanix.internal.http</shadedPattern></relocation>
                    </relocations>
                    <filters><filter><artifact>*:*</artifact><excludes>
                        <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
                        <exclude>module-info.class</exclude><exclude>META-INF/versions/**/module-info.class</exclude>
                    </excludes></filter></filters>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                    </transformers>
                </configuration>
            </execution></executions>
        </plugin>
    </plugins></build>
</project>
