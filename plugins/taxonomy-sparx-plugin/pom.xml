<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Independent operator-installed artifact; no host implementation dependency. -->
    <groupId>com.taxonomy</groupId>
    <artifactId>taxonomy-sparx-plugin</artifactId>
    <version>1.5.3-SNAPSHOT</version>
    <name>Taxonomy Sparx QEA Read Plugin</name>
    <licenses><license><name>MIT License</name><url>https://opensource.org/licenses/MIT</url></license></licenses>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <taxonomy.sdk.version>${project.version}</taxonomy.sdk.version>
        <!-- Verified against the upstream 2026-10-29 release, not inferred from a version range. -->
        <sqlite.version>3.54.1.0</sqlite.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.taxonomy</groupId><artifactId>taxonomy-extension-api</artifactId>
            <version>${taxonomy.sdk.version}</version><scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>${sqlite.version}</version></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.20</version><scope>provided</scope></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-nop</artifactId><version>2.0.20</version><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope></dependency>
    </dependencies>
    <build><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.0</version>
            <configuration><argLine>--enable-native-access=ALL-UNNAMED</argLine></configuration>
        </plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.7.0</version>
            <executions><execution><id>standalone-plugin-boundary</id><goals><goal>enforce</goal></goals>
                <configuration><rules><bannedDependencies><searchTransitive>true</searchTransitive><excludes>
                    <exclude>com.taxonomy:taxonomy-app</exclude><exclude>com.taxonomy:taxonomy-interop</exclude>
                    <exclude>com.taxonomy:taxonomy-export</exclude><exclude>com.taxonomy:taxonomy-domain</exclude>
                    <exclude>com.taxonomy:taxonomy-dsl</exclude><exclude>org.neo4j:*</exclude>
                    <exclude>org.springframework:*</exclude><exclude>org.springframework.boot:*</exclude>
                    <exclude>org.pf4j:*</exclude><exclude>com.mysql:*</exclude><exclude>schmitze87:*</exclude>
                </excludes></bannedDependencies></rules></configuration>
            </execution></executions>
        </plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.1</version>
            <configuration><archive><manifestEntries>
                <Plugin-Id>taxonomy.sparx</Plugin-Id>
                <Plugin-Version>${project.version}</Plugin-Version>
                <Plugin-Requires>&gt;=1.3.0 &amp; &lt;2.0.0</Plugin-Requires>
                <Taxonomy-Plugin-Mode>STARTUP</Taxonomy-Plugin-Mode>
                <Taxonomy-Plugin-Capabilities>integration.read</Taxonomy-Plugin-Capabilities>
                <Multi-Release>true</Multi-Release>
            </manifestEntries></archive></configuration>
        </plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
            <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <shadedArtifactAttached>false</shadedArtifactAttached>
                    <!-- SQLite's JNI class/resource names must remain intact. STARTUP provides one owner. -->
                    <filters><filter><artifact>org.xerial:sqlite-jdbc</artifact><excludes>
                        <exclude>META-INF/MANIFEST.MF</exclude>
                    </excludes></filter><filter><artifact>*:*</artifact><excludes>
                        <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
                        <exclude>module-info.class</exclude><exclude>META-INF/versions/**/module-info.class</exclude>
                    </excludes></filter></filters>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    </transformers>
                </configuration>
            </execution></executions>
        </plugin>
    </plugins></build>
</project>
