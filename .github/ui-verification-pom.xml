<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.taxonomy</groupId>
    <artifactId>taxonomy-ui-verification</artifactId>
    <version>1</version>
    <packaging>jar</packaging>
    <name>Taxonomy UI Verification Authority</name>

    <properties>
        <!-- Browser/contract lanes produce commit-bound evidence and must execute. -->
        <maven.build.cache.enabled>false</maven.build.cache.enabled>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.1</spring-boot.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <node.version>v24.18.0</node.version>
        <taxonomy.ui.junit.directory>${project.build.directory}/failsafe-reports</taxonomy.ui.junit.directory>
    </properties>

    <dependencyManagement><dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-dependencies</artifactId><version>${spring-boot.version}</version><type>pom</type><scope>import</scope></dependency>
    </dependencies></dependencyManagement>
    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>tools.jackson.core</groupId><artifactId>jackson-databind</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <pluginManagement><plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.5.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.1</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.6</version></plugin>
        </plugins></pluginManagement>
        <testSourceDirectory>${project.basedir}/../taxonomy-build/src/test/java</testSourceDirectory>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
                <configuration><testIncludes><testInclude>**/ExternalDriverSupport.java</testInclude><testInclude>**/DriverOutcomeChecksTest.java</testInclude><testInclude>**/UiScenarioIT.java</testInclude><testInclude>**/InteroperabilityProductsIT.java</testInclude><testInclude>**/ProductionImageIT.java</testInclude></testIncludes></configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>contracts</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <configuration>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <installDirectory>${project.basedir}/../.cache/ui-frontend</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-pinned-node</id>
                                <phase>generate-resources</phase>
                                <goals><goal>install-node-and-npm</goal></goals>
                                <configuration><nodeVersion>${node.version}</nodeVersion></configuration>
                            </execution>
                            <execution>
                                <id>install-pinned-contract-dependencies</id>
                                <phase>process-resources</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration><arguments>ci --ignore-scripts --no-audit --no-fund</arguments></configuration>
                            </execution>
                            <execution>
                                <id>run-ui-contracts</id>
                                <phase>test</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration><arguments>run verify:ui-contracts</arguments></configuration>
                            </execution>
                            <!-- Native browser packages belong to the shard runners.
                                 Contracts never launch browsers, and installing OS packages
                                 here cannot prepare the separate browser-shard machines. -->
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>shard</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <configuration>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <installDirectory>${project.basedir}/../.cache/ui-frontend</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-pinned-node</id>
                                <phase>generate-resources</phase>
                                <goals><goal>install-node-and-npm</goal></goals>
                                <configuration><nodeVersion>${node.version}</nodeVersion></configuration>
                            </execution>
                            <execution>
                                <id>install-pinned-browser-dependencies</id>
                                <phase>process-resources</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration><arguments>ci --ignore-scripts --no-audit --no-fund</arguments></configuration>
                            </execution>
                            <execution>
                                <id>install-pinned-playwright-browsers</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration><arguments>run install:playwright:github</arguments></configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
                        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                        <configuration><reportsDirectory>${taxonomy.ui.junit.directory}</reportsDirectory><skipITs>false</skipITs><includes><include>**/UiScenarioIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests><failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                            <systemPropertyVariables><taxonomy.ui.skip>false</taxonomy.ui.skip>
                                <taxonomy.node.executable>${project.basedir}/../.cache/ui-frontend/node/node</taxonomy.node.executable>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>interoperability</id>
            <build><plugins>
                <plugin><groupId>com.github.eirslett</groupId><artifactId>frontend-maven-plugin</artifactId><version>${frontend-maven-plugin.version}</version>
                    <configuration><workingDirectory>${project.basedir}</workingDirectory><installDirectory>${project.basedir}/../.cache/ui-frontend</installDirectory></configuration>
                    <executions><execution><id>install-product-driver-node</id><phase>generate-resources</phase><goals><goal>install-node-and-npm</goal></goals><configuration><nodeVersion>${node.version}</nodeVersion></configuration></execution></executions>
                </plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
                    <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                    <configuration><skipITs>false</skipITs><includes><include>**/InteroperabilityProductsIT.java</include></includes>
                        <failIfNoTests>true</failIfNoTests><failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                        <systemPropertyVariables><taxonomy.interoperability.skip>false</taxonomy.interoperability.skip><taxonomy.node.executable>${project.basedir}/../.cache/ui-frontend/node/node</taxonomy.node.executable></systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins></build>
        </profile>
        <profile>
            <id>image</id>
            <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                <configuration><skipITs>false</skipITs><includes><include>**/ProductionImageIT.java</include></includes>
                    <failIfNoTests>true</failIfNoTests><failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                    <systemPropertyVariables><taxonomy.production.image.skip>false</taxonomy.production.image.skip></systemPropertyVariables>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>evidence-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <configuration>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <installDirectory>${project.basedir}/../.cache/ui-frontend</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-pinned-node</id>
                                <phase>generate-resources</phase>
                                <goals><goal>install-node-and-npm</goal></goals>
                                <configuration><nodeVersion>${node.version}</nodeVersion></configuration>
                            </execution>
                            <execution>
                                <id>verify-complete-ui-shard-evidence</id>
                                <phase>test</phase>
                                <goals><goal>npm</goal></goals>
                                <configuration><arguments>run verify:ui-shards</arguments></configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
