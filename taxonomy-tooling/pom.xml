<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.taxonomy</groupId>
        <artifactId>taxonomy</artifactId>
        <version>1.5.2</version>
    </parent>

    <artifactId>taxonomy-tooling</artifactId>
    <packaging>jar</packaging>
    <name>Taxonomy Build and Release Tooling</name>
    <description>Dependency-free Java command line tooling for release, version and repository policy operations.</description>

    <properties><!-- Script and repository policy inputs extend beyond this module cache key. --><maven.build.cache.enabled>false</maven.build.cache.enabled></properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.taxonomy.tooling.TaxonomyTooling</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- The existing fast UI contract job owns these callbacks in split CI. -->
        <profile>
            <id>ci-app-test-shards-core</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration><excludes><exclude>**/JavascriptContractTest.java</exclude></excludes></configuration>
            </plugin></plugins></build>
        </profile>
        <!-- Only the native browser driver redirects reports. Ordinary lanes inherit
             their parent profile directory so publication sees the original XML. -->
        <profile>
            <id>javascript-junit-reports</id>
            <activation><property><name>taxonomy.javascript.reports</name></property></activation>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration><reportsDirectory>${taxonomy.javascript.reports}</reportsDirectory></configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
