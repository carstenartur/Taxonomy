+test('disabled secondary analysis action preserves accessible contrast', () => {
+  assert.match(workflowCssSource,
+    /\.analysis-secondary-action\s*\{[^}]*--bs-btn-disabled-color:\s*var\(--bs-primary-text-emphasis,\s*#052c65\);[^}]*--bs-btn-disabled-bg:\s*transparent;[^}]*--bs-btn-disabled-border-color:\s*var\(--bs-primary-text-emphasis,\s*#052c65\);[^}]*\}/s);
+  assert.match(workflowCssSource,
+    /\.analysis-secondary-action:disabled,\s*\.analysis-secondary-action\.disabled\s*\{[^}]*opacity:\s*1;[^}]*\}/s);
+  assert.doesNotMatch(workflowCssSource,
+    /\.analysis-secondary-action:disabled[^}]*opacity:\s*0\.[0-9]+;/s);
+});
